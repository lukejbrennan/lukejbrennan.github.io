---
---
[
{%- assign all_items = site.posts | concat: site.notes -%}
{%- for item in all_items -%}
  {%- assign cats = item.categories | default: item.category -%}
  {%- assign cat = cats | first -%}
  {%- assign tag = item.section | default: cat | default: "unfiled" -%}
  {
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "tag": {{ tag | jsonify }},
    "snippet": {{ item.content | strip_html | normalize_whitespace | truncate: 600 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
